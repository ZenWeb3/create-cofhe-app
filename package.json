{
  "name": "create-cofhe-app",
  "version": "0.1.0",
  "description": "Scaffold a Fhenix CoFHE dApp with the current @cofhe/sdk stack",
  "keywords": [
    "cofhe",
    "fhenix",
    "fhe",
    "scaffold",
    "hardhat",
    "foundry",
    "solidity"
  ],
  "license": "MIT",
  "author": "ZenWeb3",
  "homepage": "https://github.com/ZenWeb3/create-cofhe-app#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZenWeb3/create-cofhe-app.git"
  },
  "bugs": {
    "url": "https://github.com/ZenWeb3/create-cofhe-app/issues"
  },
  "type": "module",
  "bin": {
    "create-cofhe-app": "./dist/index.js",
    "cofhe": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-templates.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.0",
    "commander": "^14.0.0",
    "execa": "^9.5.2",
    "fs-extra": "^11.2.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}

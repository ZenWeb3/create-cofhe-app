pragma solidity ^0.8.28;

import {CofheTest} from "@cofhe/foundry-plugin/CofheTest.sol";
import {CofheClient} from "@cofhe/foundry-plugin/CofheClient.sol";
import {externalEuint64} from "@fhenixprotocol/cofhe-contracts/FHE.sol";
import {EncryptedToken} from "../contracts/EncryptedToken.sol";

contract EncryptedTokenTest is CofheTest {
    uint256 private constant ALICE_PKEY = 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80;
    uint256 private constant BOB_PKEY = 0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d;

    CofheClient private alice;
    CofheClient private bob;
    EncryptedToken private token;

    function setUp() public {
        deployMocks();

        alice = createCofheClient();
        alice.connect(ALICE_PKEY);
        bob = createCofheClient();
        bob.connect(BOB_PKEY);

        token = new EncryptedToken("Encrypted Token", "eTKN");
    }

    function test_mint() public {
        _mint(alice.account(), 1000);

        expectPlaintext(token.balanceOf(alice.account()), uint64(1000));
        expectPlaintext(token.totalSupply(), uint64(1000));
    }

    function test_transfer() public {
        _mint(alice.account(), 1000);
        _transfer(alice, bob.account(), 300);

        expectPlaintext(token.balanceOf(alice.account()), uint64(700));
        expectPlaintext(token.balanceOf(bob.account()), uint64(300));
    }

    function test_transferAboveBalanceMovesNothing() public {
        _mint(alice.account(), 50);
        _transfer(alice, bob.account(), 999);

        expectPlaintext(token.balanceOf(alice.account()), uint64(50));
        expectPlaintext(token.balanceOf(bob.account()), uint64(0));
    }

    function _mint(address to, uint64 amount) private {
        (externalEuint64 handle, bytes memory signature) = _encrypt(amount);
        externalEuint64[] memory handles = new externalEuint64[](1);
        handles[0] = handle;

        token.mint(to, handles, signature);
    }

    function _transfer(CofheClient client, address to, uint64 amount) private {
        (externalEuint64 handle, bytes memory signature) = client.createExternalEuint64(amount, address(token));
        externalEuint64[] memory handles = new externalEuint64[](1);
        handles[0] = handle;

        vm.prank(client.account());
        token.transfer(to, handles, signature);
    }

    function _encrypt(uint64 amount) private returns (externalEuint64, bytes memory) {
        CofheClient owner = createCofheClient();
        owner.connect(uint256(uint160(address(this))));
        return owner.createExternalEuint64(amount, address(token));
    }
}

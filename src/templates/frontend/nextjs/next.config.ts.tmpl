import type { NextConfig } from 'next'

const nextConfig: NextConfig = {
  // The SDK loads tfhe's wasm lazily and proves inside a module worker.
  // Turbopack deadlocks while bundling that worker, so the scripts pass --webpack.
  transpilePackages: ['@cofhe/sdk'],
  agentRules: false,
  async headers() {
    return [
      {
        // Cross-origin isolation lets tfhe prove with a multi-threaded wasm pool.
        source: '/:path*',
        headers: [
          { key: 'Cross-Origin-Opener-Policy', value: 'same-origin' },
          { key: 'Cross-Origin-Embedder-Policy', value: 'credentialless' },
        ],
      },
    ]
  },
}

export default nextConfig

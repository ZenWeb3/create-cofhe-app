import 'dotenv/config'
import type { HardhatUserConfig } from 'hardhat/config'
import '@nomicfoundation/hardhat-toolbox'
import '@cofhe/hardhat-plugin'

// Hardhat validates every network at startup, so a placeholder or malformed key here would break
// even `hardhat test`, which needs no key at all. Ignore anything that is not a 32-byte hex key.
const rawKey = process.env.PRIVATE_KEY?.trim() ?? ''
const accounts = /^(0x)?[0-9a-fA-F]{64}$/.test(rawKey) ? [rawKey.startsWith('0x') ? rawKey : `0x${rawKey}`] : []

const config: HardhatUserConfig = {
  solidity: {
    version: '0.8.28',
    settings: {
      // CoFHE contracts use transient storage — without cancun they will not compile.
      evmVersion: 'cancun',
      optimizer: { enabled: true, runs: 200 },
    },
  },
  networks: {
    'eth-sepolia': {
      url: process.env.SEPOLIA_RPC_URL || 'https://ethereum-sepolia.publicnode.com',
      chainId: 11155111,
      accounts,
    },
    'arb-sepolia': {
      url: process.env.ARBITRUM_SEPOLIA_RPC_URL || 'https://sepolia-rollup.arbitrum.io/rpc',
      chainId: 421614,
      accounts,
    },
  },
  cofhe: {
    logMocks: false,
    gasSummary: false,
  },
}

export default config
